{
  "name": "gir-studio-desk",
  "productName": "GIR Studio Desk",
  "version": "0.2.16",
  "private": true,
  "description": "GIR Studio Desk Windows work ledger",
  "main": "main.cjs",
  "author": "GIR",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "pg": "^8.23.1"
  },
  "build": {
    "appId": "com.gir.studiodesk",
    "productName": "GIR Studio Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "app.js",
      "style.css",
      "extras.css",
      "assets/gir-icon.png",
      "import-xlsx.ps1",
      "vendor/supabase.js"
    ],
    "asarUnpack": [
      "import-xlsx.ps1"
    ],
    "publish": {
      "provider": "github",
      "owner": "getitrendered",
      "repo": "gir-studio-desk",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/gir-icon.ico",
      "executableName": "GIR Studio Desk",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "GIR-Studio-Desk-${version}-Setup.${ext}",
      "installerIcon": "assets/gir-icon.ico",
      "uninstallerIcon": "assets/gir-icon.ico"
    }
  }
}
